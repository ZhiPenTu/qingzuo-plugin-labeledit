{
  "name": "qingzuo-plugin-labeledit",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "commerce": {
    "manifestVersion": 1,
    "id": "official.labeledit",
    "title": "LabelEdit",
    "description": "本地 PDF 标签编辑、文字识别与导出",
    "category": "标签与文档",
    "api": "^1.1.0",
    "ui": "ui/index.html",
    "releaseNotes": "独立仓库发布，通用私有图片资源与离线 PDF/OCR。",
    "permissions": {
      "files": true
    },
    "services": {
      "provides": [
        "labeledit.pdf"
      ]
    },
    "backend": {
      "type": "executable",
      "entry": {
        "darwin-arm64": "backend/label-edit-backend/label-edit-backend",
        "win32-x64": "backend/label-edit-backend/label-edit-backend.exe"
      }
    }
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:backend": "python -m pytest -q",
    "build:backend": "python scripts/build_backend.py --distpath release/plugin/backend",
    "pack": "node scripts/pack-plugin.mjs",
    "test:host": "node tests/host.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@commerce/plugin-sdk": "https://github.com/ZhiPenTu/LabelEdit/releases/download/sdk-v1.1.1/commerce-plugin-sdk-1.1.1.tgz",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
